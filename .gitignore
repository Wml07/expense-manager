# ⚠️ 密钥文件 —— 永远不进版本库。别人用 .env.example 自己填一份。
.env
.env.local

# Python 自动生成的缓存，不该进版本库
__pycache__/
*.pyc

# 虚拟环境（venv）—— 体积大、且随时能重建，永远不进版本库
testenv/
venv/
.venv/

# 向量库：能随时用 rag2.py 重建，属"生成物"，不入版本库
xiangliang.json

# 账本数据：使用时才产生的用户数据，不是代码，不入版本库
zhangben.txt

# 根目录下一次性的诊断 / 临时产物（下划线开头的日志、抓下来的网页、测试图）
# —— 只挡根目录，别挡住 core/_probe_*.py 那些故意留下来的探针
/_*.log
/_*.html
/_*.gif
/_*.png
/_*.txt
