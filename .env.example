# 用法：把本文件复制成 .env（去掉 .example），再把下面两个 key 填上。
#
#   copy .env.example .env        （Windows）
#   cp .env.example .env          （macOS / Linux）
#
# ⚠️ .env 千万不要提交到 git —— .gitignore 已经把它挡住了。
#    密钥写进代码或提交记录里，等于把家门钥匙贴在门上。

# ① 聊天用（负责"说人话"）—— 智谱开放平台，glm-4-flash 有免费额度
#    申请：https://open.bigmodel.cn
ZHIPU_API_KEY=

# ② 向量用（负责"把文字变成数字"）—— 硅基流动，BAAI/bge-m3 免费
#    申请：https://cloud.siliconflow.cn
#    注意：要选不带 "Pro" 的那个 bge-m3
SILICONFLOW_API_KEY=
